rules_version = '2';

// ============================================================
// firestore.rules — Reglas de seguridad de Viajoo.
//
// Reflejan exactamente lo que usa cloud.js hoy:
//   - users/{uid}         -> copia de seguridad íntegra del usuario
//   - shared_trips/{code} -> un viaje compartido por código de 6 caracteres
//
// paid_query_usage/* (contador diario de consultas de pago por cuenta,
// usado por functions/index.js) NO tiene regla propia a propósito: cae
// en el bloqueo por defecto de más abajo, así ningún cliente puede
// leerlo ni tocarlo directamente — solo el Admin SDK de la Cloud
// Function, que no pasa por estas reglas.
//
// Nota sobre "Pro": hoy el plan gratuito/premium se controla solo en
// el cliente (pro.js, guardado local). Estas reglas NO comprueban el
// plan porque el cliente puede mentir sobre ello; si en el futuro el
// plan se guarda también en el documento del usuario (p. ej. un campo
// "plan" en users/{uid}), se puede añadir aquí una comprobación real
// de "isPro" leyendo ese documento antes de permitir crear/actualizar
// en shared_trips.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Copia de seguridad personal (pushToCloud / pullFromCloud) ---
    // Solo el propio usuario puede leer o escribir su documento.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // --- Viajes compartidos (shareTrip / joinSharedTrip) ---
    // El id del documento ES el código de 6 caracteres: conocer el
    // código equivale a tener la invitación (igual que un enlace para
    // compartir). Por eso cualquier usuario autenticado puede LEER un
    // shared_trips si sabe el código exacto, pero solo el dueño o los
    // miembros ya unidos pueden escribir el contenido del viaje.
    match /shared_trips/{code} {

      allow read: if request.auth != null;

      // Crear un viaje compartido: solo puedes crearlo como su dueño,
      // y tienes que aparecer ya como primer miembro.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;

      // Actualizar: dos casos válidos.
      // 1) Ya eres miembro (dueño u otro invitado) y subes cambios del
      //    viaje (pushSharedTripIfNeeded / refreshSharedTrip).
      // 2) Te estás uniendo ahora mismo (joinSharedTrip): el único
      //    cambio permitido en ese caso es añadirte a "members", sin
      //    tocar el dueño ni quitar a nadie de la lista.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.auth.uid in request.resource.data.members
        )
      );

      // Borrar un viaje compartido: solo el dueño original.
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }

    // Cualquier otra ruta queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
